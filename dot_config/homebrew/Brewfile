# Single source of truth for Homebrew on every machine.
# `brew-sync` (run by chezmoi and the dotfiles-sync launch agent) installs what's here and,
# on machines with brewCleanup enabled, uninstalls anything that isn't. It never upgrades:
# run `brew upgrade` yourself when you want new versions.

tap "nikitabobko/tap"

# Shell & CLI
brew "chezmoi"
brew "fd"
brew "fzf"
brew "gh"
brew "lazygit"
brew "ripgrep"
brew "tmux"

# Editor
brew "neovim"
brew "luarocks"

# Languages & runtimes
brew "go"
brew "fnm"   # Node versions
brew "uv"    # Python

# Pinned major version: moving Postgres to a new major needs a manual pg_upgrade of the data dir
brew "postgresql@18"

# Apps
cask "nikitabobko/tap/aerospace"
cask "appcleaner"
cask "ghostty"
