# uv/rustup standalone-installer env; guard it so a fresh machine (where the file
# may not exist because these come from Homebrew) doesn't error on every new shell.
[ -s "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

eval "$(fnm env --use-on-cd)"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

if command -v fzf >/dev/null 2>&1; then
  # Alt-C (Esc-c): only list dirs in the current level, never recurse into subdirs.
  export FZF_ALT_C_COMMAND='fd --type d --max-depth 1 --hidden --follow --exclude .git'
  source <(fzf --zsh)
fi

# Homebrew only upgrades when explicitly asked (`brew upgrade`): `brew install foo` won't
# also upgrade foo if outdated, and upgrading one package won't cascade into its dependents.
export HOMEBREW_NO_INSTALL_UPGRADE=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1

alias sirch_browser="cd ~/Documents/GitHub/sirch_browser"
alias projects="cd ~/Documents/GitHub"
# Make Homebrew match the Brewfile (installs missing, removes extras on cleanup-enabled machines).
alias brew-install="brew-sync"
# Pull + apply dotfiles, then brew-sync, right now. The dotfiles-sync launch agent also runs it
# on its own (at most every 4h, only while you're at the Mac).
alias chezmoi-sync="dotfiles-sync --now && source ~/.zshrc"
